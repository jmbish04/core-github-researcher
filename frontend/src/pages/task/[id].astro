---
import Layout from '../../layouts/Layout.astro';
import '../../styles/globals.css';

// This is a dynamic route that will be handled client-side
// For static builds, we generate a placeholder page
export function getStaticPaths() {
  // Generate a placeholder path - actual routing is handled client-side
  return [{ params: { id: '_' } }];
}
---

<Layout title="Task Results - GitHub Research Agent">
  <div class="container mx-auto px-4 py-8 max-w-4xl">
    <div class="mb-6">
      <a href="/" class="text-sm text-muted-foreground hover:text-foreground inline-flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m12 19-7-7 7-7"/>
          <path d="M19 12H5"/>
        </svg>
        Back to Dashboard
      </a>
    </div>
    
    <div id="loading" class="card p-8 text-center">
      <svg class="animate-spin mx-auto h-8 w-8 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <p class="mt-4 text-muted-foreground">Loading results...</p>
    </div>
    
    <div id="error" class="hidden card p-8 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-4 text-red-400">
        <circle cx="12" cy="12" r="10"/>
        <path d="m15 9-6 6"/>
        <path d="m9 9 6 6"/>
      </svg>
      <h2 class="text-lg font-semibold">Error Loading Results</h2>
      <p id="error-message" class="mt-2 text-muted-foreground"></p>
      <a href="/" class="btn btn-primary btn-md mt-4">Return to Dashboard</a>
    </div>
    
    <div id="content" class="hidden">
      <div class="card p-6 mb-6">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h1 class="text-2xl font-bold" id="task-query"></h1>
            <p class="text-muted-foreground mt-1" id="task-meta"></p>
          </div>
          <span id="status-badge" class="badge"></span>
        </div>
      </div>
      
      <div id="results-container" class="space-y-4">
        <!-- Results will be rendered here -->
      </div>
    </div>
  </div>
</Layout>

<script>
  interface Task {
    id: string;
    query: string;
    status: string;
    createdAt: string;
    updatedAt: string;
  }
  
  interface Finding {
    id: string;
    repoId: string;
    summary: string;
    findings: {
      readme?: string;
      packageInfo?: string;
      recentActivity?: string;
    };
  }
  
  interface TaskFindings {
    task: Task | null;
    results: Finding[];
  }
  
  const loadingEl = document.getElementById('loading');
  const errorEl = document.getElementById('error');
  const errorMessageEl = document.getElementById('error-message');
  const contentEl = document.getElementById('content');
  const taskQueryEl = document.getElementById('task-query');
  const taskMetaEl = document.getElementById('task-meta');
  const statusBadgeEl = document.getElementById('status-badge');
  const resultsContainer = document.getElementById('results-container');
  
  // Extract task ID from URL
  const pathParts = window.location.pathname.split('/');
  const taskId = pathParts[pathParts.length - 1];
  
  function showError(message: string) {
    loadingEl?.classList.add('hidden');
    contentEl?.classList.add('hidden');
    errorEl?.classList.remove('hidden');
    if (errorMessageEl) errorMessageEl.textContent = message;
  }
  
  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }
  
  function formatDate(dateStr: string): string {
    try {
      return new Date(dateStr).toLocaleString();
    } catch {
      return dateStr;
    }
  }
  
  function getStatusBadgeClass(status: string): string {
    const classes: Record<string, string> = {
      pending: 'badge-pending',
      searching: 'badge-searching',
      waiting_for_approval: 'badge-waiting',
      analyzing: 'badge-analyzing',
      completed: 'badge-completed',
      rejected: 'badge-rejected',
      timed_out: 'badge-timed_out',
    };
    return classes[status] || 'badge-pending';
  }
  
  function renderResults(findings: TaskFindings) {
    if (!resultsContainer) return;
    
    if (findings.results.length === 0) {
      resultsContainer.innerHTML = `
        <div class="card p-8 text-center text-muted-foreground">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-4 text-muted-foreground/50">
            <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>
          </svg>
          <p>No analysis results available</p>
        </div>
      `;
      return;
    }
    
    resultsContainer.innerHTML = findings.results.map(finding => `
      <div class="card p-6">
        <h3 class="font-semibold text-lg mb-2">${escapeHtml(finding.summary.split('\\n')[0])}</h3>
        <pre class="text-sm text-muted-foreground mb-4 whitespace-pre-wrap">${escapeHtml(finding.summary)}</pre>
        
        <div class="space-y-3 text-sm">
          ${finding.findings.readme ? `
            <details class="group">
              <summary class="cursor-pointer text-muted-foreground hover:text-foreground flex items-center gap-2 font-medium">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-open:rotate-90">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
                README Preview
              </summary>
              <pre class="mt-2 p-4 bg-muted rounded-md text-xs overflow-x-auto whitespace-pre-wrap max-h-96 overflow-y-auto">${escapeHtml(finding.findings.readme)}</pre>
            </details>
          ` : ''}
          
          ${finding.findings.packageInfo && finding.findings.packageInfo !== 'No package.json found' ? `
            <details class="group">
              <summary class="cursor-pointer text-muted-foreground hover:text-foreground flex items-center gap-2 font-medium">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-open:rotate-90">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
                Package Info
              </summary>
              <pre class="mt-2 p-4 bg-muted rounded-md text-xs overflow-x-auto">${escapeHtml(finding.findings.packageInfo)}</pre>
            </details>
          ` : ''}
          
          ${finding.findings.recentActivity ? `
            <details class="group">
              <summary class="cursor-pointer text-muted-foreground hover:text-foreground flex items-center gap-2 font-medium">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-open:rotate-90">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
                Recent Activity
              </summary>
              <pre class="mt-2 p-4 bg-muted rounded-md text-xs overflow-x-auto whitespace-pre-wrap">${escapeHtml(finding.findings.recentActivity)}</pre>
            </details>
          ` : ''}
        </div>
      </div>
    `).join('');
  }
  
  async function loadTaskResults() {
    try {
      const response = await fetch(`/api/research/findings/${taskId}`);
      if (!response.ok) {
        throw new Error('Failed to load task results');
      }
      
      const findings: TaskFindings = await response.json();
      
      if (!findings.task) {
        showError('Task not found');
        return;
      }
      
      loadingEl?.classList.add('hidden');
      contentEl?.classList.remove('hidden');
      
      if (taskQueryEl) taskQueryEl.textContent = findings.task.query;
      if (taskMetaEl) {
        taskMetaEl.textContent = `Created: ${formatDate(findings.task.createdAt)} • ${findings.results.length} repositories analyzed`;
      }
      if (statusBadgeEl) {
        statusBadgeEl.textContent = findings.task.status.replace(/_/g, ' ');
        statusBadgeEl.className = `badge ${getStatusBadgeClass(findings.task.status)}`;
      }
      
      renderResults(findings);
    } catch (error) {
      showError(error instanceof Error ? error.message : 'An error occurred');
    }
  }
  
  // Load task on page load
  loadTaskResults();
</script>
