---
interface Finding {
  id: string;
  repoId: string;
  summary: string;
  findings: {
    readme?: string;
    packageInfo?: string;
    recentActivity?: string;
  };
}

interface Props {
  findings: Finding[];
}

const { findings } = Astro.props;
---

<div class="space-y-4">
  {findings.length === 0 ? (
    <div class="text-center py-8 text-muted-foreground">
      No findings available
    </div>
  ) : (
    findings.map((finding) => (
      <div class="card p-4">
        <h3 class="font-semibold text-foreground mb-2">{finding.summary.split('\n')[0]}</h3>
        
        <div class="space-y-3 text-sm">
          {finding.findings.readme && (
            <details class="group">
              <summary class="cursor-pointer text-muted-foreground hover:text-foreground flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-open:rotate-90">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
                README Preview
              </summary>
              <pre class="mt-2 p-3 bg-muted rounded-md text-xs overflow-x-auto whitespace-pre-wrap">{finding.findings.readme}</pre>
            </details>
          )}
          
          {finding.findings.packageInfo && finding.findings.packageInfo !== 'No package.json found' && (
            <details class="group">
              <summary class="cursor-pointer text-muted-foreground hover:text-foreground flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-open:rotate-90">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
                Package Info
              </summary>
              <pre class="mt-2 p-3 bg-muted rounded-md text-xs overflow-x-auto">{finding.findings.packageInfo}</pre>
            </details>
          )}
          
          {finding.findings.recentActivity && (
            <details class="group">
              <summary class="cursor-pointer text-muted-foreground hover:text-foreground flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-open:rotate-90">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
                Recent Activity
              </summary>
              <pre class="mt-2 p-3 bg-muted rounded-md text-xs overflow-x-auto whitespace-pre-wrap">{finding.findings.recentActivity}</pre>
            </details>
          )}
        </div>
      </div>
    ))
  )}
</div>
