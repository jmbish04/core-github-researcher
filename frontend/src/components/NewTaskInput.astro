---
// NewTaskInput is a form component for starting new research
// It uses client-side JavaScript for form submission
---

<div class="card p-6">
  <h2 class="text-lg font-semibold mb-4">Start New Research</h2>
  
  <form id="new-task-form" class="space-y-4">
    <div class="space-y-2">
      <label for="query" class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">
        Research Query
      </label>
      <input
        type="text"
        id="query"
        name="query"
        placeholder="e.g., Cloudflare Workers authentication"
        required
        class="input"
      />
    </div>
    
    <div class="grid grid-cols-2 gap-4">
      <div class="space-y-2">
        <label for="language" class="text-sm font-medium leading-none">
          Language (optional)
        </label>
        <input
          type="text"
          id="language"
          name="language"
          placeholder="e.g., typescript"
          class="input"
        />
      </div>
      
      <div class="space-y-2">
        <label for="limit" class="text-sm font-medium leading-none">
          Max Results
        </label>
        <input
          type="number"
          id="limit"
          name="limit"
          min="1"
          max="20"
          value="10"
          class="input"
        />
      </div>
    </div>
    
    <button type="submit" class="btn btn-primary btn-md w-full" id="submit-btn">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.3-4.3"/>
      </svg>
      Start Research
    </button>
  </form>
  
  <div id="form-message" class="mt-4 hidden"></div>
</div>

<script>
  const form = document.getElementById('new-task-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const messageDiv = document.getElementById('form-message') as HTMLDivElement;
  
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const query = formData.get('query') as string;
    const language = formData.get('language') as string;
    const limit = parseInt(formData.get('limit') as string) || 10;
    
    if (!query.trim()) {
      showMessage('Please enter a research query', 'error');
      return;
    }
    
    submitBtn.disabled = true;
    submitBtn.innerHTML = `
      <svg class="animate-spin mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      Starting...
    `;
    
    try {
      const response = await fetch('/api/research/start', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          query: query.trim(),
          language: language.trim() || undefined,
          limit,
        }),
      });
      
      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.message || 'Failed to start research');
      }
      
      const task = await response.json();
      showMessage(`Research started! Task ID: ${task.id}`, 'success');
      form.reset();
      
      // Reload the page after a short delay to show the new task
      setTimeout(() => {
        window.location.reload();
      }, 1500);
    } catch (error) {
      showMessage(error instanceof Error ? error.message : 'An error occurred', 'error');
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.3-4.3"/>
        </svg>
        Start Research
      `;
    }
  });
  
  function showMessage(text: string, type: 'success' | 'error') {
    messageDiv.className = `mt-4 p-3 rounded-md text-sm ${
      type === 'success' 
        ? 'bg-green-500/20 text-green-400 border border-green-500/30' 
        : 'bg-red-500/20 text-red-400 border border-red-500/30'
    }`;
    messageDiv.textContent = text;
    messageDiv.classList.remove('hidden');
    
    setTimeout(() => {
      messageDiv.classList.add('hidden');
    }, 5000);
  }
</script>
